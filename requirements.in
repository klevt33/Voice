# This file lists the high-level application dependencies.
# 
# TRANSCRIPTION OPTIONS:
# The app supports two transcription methods:
# 1. Local GPU/CPU transcription (requires PyTorch + faster-whisper)
# 2. API transcription via Groq (requires groq package + API key)
#
# You can install either or both depending on your needs:

# FOR LOCAL TRANSCRIPTION (optional):
# Install PyTorch first:
# pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
# Then install faster-whisper dependencies:
faster-whisper==1.2.1
ctranslate2>=4.0,<5
# sympy==1.13.1  # Pinned by torch==2.5.1+cu121

# FOR API TRANSCRIPTION (optional):
groq

# FOR NETWORK GPU SERVER (optional - required on the GPU server machine):
fastapi
uvicorn[standard]

# FOR NETWORK GPU CLIENT (required when NETWORK_GPU_ENABLED=True):
requests

# FOR SPEAKER SEPARATION (optional - required when SPEAKER_SPLIT_ENABLED=True):
# Install MANUALLY — do not add to this file. Must pin 3.3.2: pyannote 4.x
# requires torch>=2.8 and would clobber the pinned CUDA torch build:
# pip install "pyannote.audio==3.3.2" "speechbrain==1.0.3" "pytorch-metric-learning<3" "huggingface-hub==0.36.2" torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu121 --extra-index-url https://pypi.org/simple
# (huggingface-hub must stay <1.0 — pyannote 3.x passes use_auth_token, removed in 1.x)
# Also requires HF_TOKEN env var + accepted gated-model licenses (see SETUP_GUIDE.md).

# REQUIRED DEPENDENCIES:

# Audio processing
pyaudio
pyaudiowpatch
numpy

# Browser automation and UI
selenium
pyperclip
PyGetWindow
